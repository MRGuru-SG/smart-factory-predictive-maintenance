-- INNER JOIN
SELECT
    s.machine_id,
    s.machine_profile,
    s.temperature,
    m.location,
    m.technician
FROM sensor_data s
INNER JOIN machine_details m
    ON s.machine_id = m.machine_id;
    
  -- LEFT JOIN
  SELECT
    s.machine_id,
    s.machine_profile,
    m.location,
    m.technician
FROM sensor_data s
LEFT JOIN machine_details m
    ON s.machine_id = m.machine_id;
    
 -- SQL final project query
 SELECT
    machine_id,
    COUNT(*) AS total_readings,
    SUM(failure) AS total_failures,
    ROUND(AVG(temperature), 2) AS avg_temperature,
    SUM(downtime_minutes) AS total_downtime
FROM sensor_data
GROUP BY machine_id
ORDER BY total_failures DESC
LIMIT 5;

-- Final SQL practice — Failure Rate %
SELECT
    machine_id,
    COUNT(*) AS total_readings,
    SUM(failure) AS total_failures,
    ROUND(
        SUM(failure) * 100.0 / COUNT(*), 2
    ) AS failure_rate_pct
FROM sensor_data
GROUP BY machine_id
ORDER BY failure_rate_pct DESC
LIMIT 5;
SELECT
    COUNT(*) AS total_readings,
    SUM(failure) AS total_failures,
    ROUND(SUM(failure) * 100.0 / COUNT(*), 2) AS failure_rate,
    SUM(downtime_minutes) AS total_downtime
FROM sensor_data;



